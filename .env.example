# AI Hoca (Vertex AI) — değerleri kendi Google Cloud servis hesabından doldur.
# Yerelde: bu dosyayı .env.local olarak kopyala ve doldur (.env.local git'e girmez).
# Vercel'de: Project → Settings → Environment Variables bölümüne aynı üç değişkeni ekle.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CREDENTIALS_JSON=
